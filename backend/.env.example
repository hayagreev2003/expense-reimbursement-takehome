# Copy to backend/.env (or run `make bootstrap`, which does it for you).
# Docker Compose supplies these directly and ignores this file.

# development | test | production. A value outside that set is a boot-time ValidationError,
# not a silent fallback. Gates that depend on it allowlist the safe value.
APP_ENV=development
LOG_LEVEL=INFO

# The application's database: one SQLite file, owned entirely by this application.
# It binds no port and shares no server, so it cannot collide with another database on the
# machine. Relative paths resolve against backend/. Delete the file and `make reset-db`
# rebuilds it from migrations and seed.
DATABASE_PATH=data/expense.db

# Frontend origin. Used to build the CORS allow_origin_regex, anchored at both ends.
# Get this wrong and every credentialed request fails as an opaque network error in the browser
# while the server logs a clean 200.
WEB_HOST=http://localhost:3000

# The read-only specification pack. Relative to the repo root when unset.
# PACK_DIR=../pack

# rule_based | llm. rule_based needs no credentials and is the tested path.
# llm additionally requires ANTHROPIC_API_KEY and is untested in this build.
EXTRACTOR=rule_based
# ANTHROPIC_API_KEY=

# A second, pattern origin for hosts that mint a URL per deployment - Vercel previews, chiefly.
# A regex fragment; anchors are added for you. Unset means web_host and nothing else.
# WEB_ORIGIN_REGEX_EXTRA=https://nortex-expense-[a-z0-9-]+\.vercel\.app

# Demo reset. Off unless this is true: POST /api/v1/demo/reset deletes every claim in the
# database and re-seeds from the pack. When a token is set it must be echoed in X-Demo-Token.
DEMO_RESET_ENABLED=false
# DEMO_RESET_TOKEN=
